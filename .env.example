# Copy this file to .env and adjust as needed (or just set these as real
# environment variables before running the app).

# Local MongoDB (default if you don't set anything):
MONGO_URL=mongodb://localhost:27017
# Or a free MongoDB Atlas cluster:
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

DB_NAME=devtrack
SECRET_KEY=change-me-before-deploying

# Used only by seed/seed.py to create the first admin account
ADMIN_EMAIL=admin@devtrack.local
ADMIN_PASSWORD=admin123
